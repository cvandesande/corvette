# syntax=docker/dockerfile:1.7
ARG NCNN_TAG=20260526
ARG DEBIAN_IMAGE=debian:trixie
ARG RUST_IMAGE=rust:1.97.1-trixie

FROM ${DEBIAN_IMAGE} AS ncnn-builder
ARG NCNN_TAG
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential ca-certificates cmake git libvulkan-dev ninja-build pkg-config \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch "${NCNN_TAG}" --recursive https://github.com/Tencent/ncnn /src/ncnn
WORKDIR /src/ncnn
RUN cmake -G Ninja -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/ncnn \
        -DNCNN_VULKAN=ON \
        -DNCNN_SHARED_LIB=ON \
        -DNCNN_BUILD_EXAMPLES=OFF \
        -DNCNN_BUILD_TOOLS=OFF \
        -DNCNN_BUILD_BENCHMARK=OFF \
        -DNCNN_BUILD_TESTS=OFF \
    && cmake --build build -j"$(nproc)" \
    && cmake --install build

FROM ${RUST_IMAGE} AS rust-builder
RUN apt-get update \
    && apt-get install -y --no-install-recommends libvulkan-dev \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ncnn-builder /opt/ncnn /opt/ncnn
ENV NCNN_DIR=/opt/ncnn
WORKDIR /src
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates crates
# The workspace manifest patches proc-macro-error2 to vendor/; cargo cannot resolve without it.
COPY vendor vendor
RUN cargo build --release --locked --bin corvette-detect-worker

FROM rust-builder AS lint
RUN cargo clippy --locked --all-targets --all-features -p corvette-detect-worker -p corvette-ncnn -p corvette-yolo -p corvette-detect-proto -p ncnn-sys -- -D warnings \
    && cargo fmt --all --check

FROM rust-builder AS tools-build
RUN cargo build --release --locked --bin corvette-detect-tools

FROM scratch AS tools
COPY --from=tools-build /src/target/release/corvette-detect-tools /corvette-detect-tools

FROM ${DEBIAN_IMAGE} AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libgomp1 libvulkan1 mesa-vulkan-drivers \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ncnn-builder /opt/ncnn/lib /opt/ncnn/lib
COPY --from=ncnn-builder /src/ncnn/LICENSE.txt /usr/share/licenses/ncnn/LICENSE.txt
COPY --from=ncnn-builder /src/ncnn/glslang/LICENSE.txt /usr/share/licenses/glslang/LICENSE.txt
COPY LICENSE /usr/share/licenses/corvette/LICENSE
COPY --from=rust-builder /src/target/release/corvette-detect-worker /usr/local/bin/corvette-detect-worker
# The binary carries no run path to libncnn.so.1; this is how the loader finds it.
ENV LD_LIBRARY_PATH=/opt/ncnn/lib
ENTRYPOINT ["/usr/local/bin/corvette-detect-worker"]
