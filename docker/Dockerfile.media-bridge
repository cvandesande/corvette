# syntax=docker/dockerfile:1.7
ARG RUST_IMAGE=rust:1.97.1-trixie
ARG RUNTIME_IMAGE=debian:trixie-slim

FROM ${RUST_IMAGE} AS corvette-builder
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential ca-certificates cmake git pkg-config \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates crates
# COPY vendor: the Cargo.toml proc-macro-error2 patch requires it present.
COPY vendor vendor
RUN cargo build --release --locked --bin corvette-media-bridge

# trixie matches the builder's glibc; no CMD/ENTRYPOINT: the pod spec decides.
FROM ${RUNTIME_IMAGE} AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=corvette-builder /src/target/release/corvette-media-bridge /usr/local/bin/corvette-media-bridge
COPY LICENSE /usr/share/licenses/corvette/LICENSE
